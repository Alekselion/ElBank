{
  "name": "Gosuslugi: passport is valid (any well-formed request)",
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/gosuslugi/verify-passport",
    "headers": {
      "Content-Type": { "contains": "application/json" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.series =~ /^[0-9]{4}$/)]" },
      { "matchesJsonPath": "$[?(@.number =~ /^[0-9]{6}$/)]" },
      { "matchesJsonPath": "$[?(@.birth_date =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
    },
    "jsonBody": {
      "valid": true,
      "full_name": "Иванов Иван Иванович",
      "message": "Паспорт действителен"
    }
  }
}
