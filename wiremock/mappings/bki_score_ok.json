{
  "name": "BKI: approve with score 720 (any well-formed request)",
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/bki/score",
    "headers": {
      "Content-Type": { "contains": "application/json" },
      "Idempotency-Key": { "matches": "^[0-9a-f-]{36}$" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.application_id =~ /^[0-9a-f-]{36}$/)]" },
      { "matchesJsonPath": "$[?(@.phone =~ /^\\+[0-9]{11,15}$/)]" },
      { "matchesJsonPath": "$[?(@.amount =~ /^[0-9]+\\.[0-9]{2}$/)]" },
      { "matchesJsonPath": "$[?(@.term_months > 0)]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
    },
    "jsonBody": {
      "score": 720,
      "decision": "approve",
      "comment": "Кредитная история положительная"
    }
  }
}
