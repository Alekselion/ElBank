{
  "name": "Push gateway: timeout for devices of the test number +79990000012 (delay exceeds client timeout)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/push/send",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.phone == '+79990000012')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 10000,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "message_id": "{{randomValue type='UUID'}}",
      "status": "delivered"
    }
  }
}
