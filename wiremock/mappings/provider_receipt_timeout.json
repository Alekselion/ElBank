{
  "name": "Payment by receipt number: no answer in time (delay exceeds PROVIDERS_TIMEOUT_SECONDS)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/providers/receipt/pay",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.payload[?(@.receipt_number == '9999999999')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "fixedDelayMilliseconds": 8000,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
    },
    "bodyFileName": "providers/receipt_accepted.json"
  }
}
