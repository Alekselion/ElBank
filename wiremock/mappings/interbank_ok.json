{
  "name": "Interbank: transfer accepted (any well-formed request)",
  "priority": 10,
  "request": {
    "method": "POST",
    "url": "/interbank/transfer",
    "headers": {
      "Content-Type": { "contains": "application/json" },
      "Idempotency-Key": { "matches": "^[0-9a-f-]{36}$" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.transfer_id =~ /^[0-9a-f-]{36}$/)]" },
      { "matchesJsonPath": "$[?(@.amount =~ /^[0-9]+\\.[0-9]{2}$/)]" },
      { "matchesJsonPath": "$[?(@.currency == 'RUB')]" },
      { "matchesJsonPath": "$.payer[?(@.bic =~ /^04[0-9]{7}$/)]" },
      { "matchesJsonPath": "$.payer[?(@.account =~ /^[0-9]{20}$/)]" },
      { "matchesJsonPath": "$.payee[?(@.bic =~ /^04[0-9]{7}$/)]" },
      { "matchesJsonPath": "$.payee[?(@.account =~ /^[0-9]{20}$/)]" },
      { "matchesJsonPath": "$.payee.name" }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
    },
    "jsonBody": {
      "status": "accepted",
      "external_id": "IB-{{randomValue length=16 type='NUMERIC'}}",
      "reason": null
    }
  }
}
