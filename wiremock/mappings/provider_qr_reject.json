{
  "name": "QR code payment: refused with PAYEE_NOT_FOUND",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/providers/qr/pay",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.payload[?(@.qr =~ /.*PersonalAcc=00000000000000000000.*/)]"
      }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/json; charset=utf-8",
      "X-Correlation-Id": "{{request.headers.X-Correlation-Id}}"
    },
    "bodyFileName": "providers/qr_error.json"
  }
}
