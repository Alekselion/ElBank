# ---------- Application ----------
APP_NAME=elbank
APP_ENV=local                  # local | dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                 # true -> JSON logs on stdout (used in Docker)

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elbank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elbank
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Kafka ----------
# Comma-separated list. Host-side listener is 9094, in-cluster listener is kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CLIENT_ID=elbank

# ---------- JWT ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_ACCESS_MINUTES=15
JWT_TTL_REFRESH_DAYS=7

# ---------- Logstash ----------
LOGSTASH_ENABLED=true
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# ---------- External services ----------
WIREMOCK_BASE_URL=http://localhost:8080
ELASTIC_URL=http://localhost:9200

# ---------- Health checks ----------
READINESS_TIMEOUT_SECONDS=2.0

# ---------- docker-compose only ----------
ELK_VERSION=8.17.4
# Host port for the Redis container; keep in sync with REDIS_URL.
REDIS_HOST_PORT=6379
