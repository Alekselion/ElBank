# ---------- Application ----------
APP_NAME=elbank
APP_ENV=local                  # local | dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                  # false -> human-readable console for local dev; Logstash always gets JSON

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elbank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elbank
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_ECHO=false

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Kafka ----------
# Comma-separated list. Host-side listener is 29092, in-cluster listener is kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=elbank

# ---------- JWT ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_ACCESS_MINUTES=15
JWT_TTL_REFRESH_DAYS=30
JWT_TTL_OTP_MINUTES=5

# ---------- OTP ----------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Login rate limit (per phone) ----------
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ---------- Logstash ----------
LOGSTASH_ENABLED=true
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# ---------- External services ----------
WIREMOCK_BASE_URL=http://localhost:8081
WIREMOCK_TIMEOUT_SECONDS=5.0
GOSUSLUGI_TIMEOUT_SECONDS=5.0
GOSUSLUGI_RETRIES=2               # extra attempts on timeout / connection error / 5xx
INTERBANK_TIMEOUT_SECONDS=10.0
INTERBANK_RETRIES=2               # extra attempts on connection error / 502 / 503 / 504 only
SBP_TIMEOUT_SECONDS=10.0
SBP_RETRIES=2
PROVIDERS_TIMEOUT_SECONDS=5.0     # service providers (/providers/*/pay)
PROVIDERS_RETRIES=2               # extra attempts on 5xx / timeout / connection error, never on 4xx
CARD_PROCESSOR_TIMEOUT_SECONDS=5.0  # /card-processor/*
CARD_PROCESSOR_RETRIES=2            # extra attempts on 5xx / timeout / connection error, never on 4xx
BKI_TIMEOUT_SECONDS=5.0             # credit bureau scoring (/bki/score)
BKI_RETRIES=2
BROKER_TIMEOUT_SECONDS=5.0          # /broker/quotes, /broker/orders
BROKER_RETRIES=2
CBR_TIMEOUT_SECONDS=5.0
CBR_RETRIES=2
CBR_RATES_CACHE_TTL_SECONDS=60    # Redis rates:{base}:{quote}

# ---------- KYC ----------
KYC_UPLOADS_DIR=uploads           # docker-compose overrides with /app/uploads (named volume)
KYC_MAX_UPLOAD_BYTES=5242880
ELASTIC_URL=http://localhost:9200

# ---------- Bank requisites (pseudo) ----------
BANK_NAME="АО «ЭлБанк»"
BANK_BIC=044525999                # correspondent account is derived from the BIC
BANK_INN=7700000000
BANK_KPP=770001001
BANK_SWIFT=ELBKRUMM
BANK_BRANCH_CODE=0001             # positions 10-13 of account numbers

# ---------- Accounts ----------
ACCOUNTS_LIST_CACHE_TTL_SECONDS=30
ACCOUNTS_DEFAULT_DAILY_LIMIT=100000.00
ACCOUNTS_DEFAULT_MONTHLY_LIMIT=1000000.00

# ---------- Cards ----------
# HMAC key for cards.pan_hash (at least 32 chars). Changing it invalidates every stored hash.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CARDS_PAN_HASH_KEY=change-me-to-a-random-string-of-at-least-32-chars
CARDS_MAX_PER_ACCOUNT=5             # active + blocked cards per account
CARDS_DEFAULT_DAILY_LIMIT=100000.00
CARDS_DEFAULT_MONTHLY_LIMIT=500000.00
CARDS_DEFAULT_PER_TRANSACTION_LIMIT=50000.00

# ---------- Credits ----------
CREDITS_MIN_AMOUNT=10000.00
CREDITS_MAX_AMOUNT=5000000.00
CREDITS_MIN_TERM_MONTHS=3
CREDITS_MAX_TERM_MONTHS=84
CREDITS_MIN_SCORE=600              # approved if the bureau says approve AND score >= this
CREDITS_BASE_RATE=21.9             # percent per year
CREDITS_GOOD_SCORE=750
CREDITS_GOOD_SCORE_RATE=17.9       # rate for score >= CREDITS_GOOD_SCORE

# ---------- Deposits ----------
DEPOSITS_MIN_AMOUNT=1000.00
DEPOSITS_MAX_RATE=18               # the client chooses the rate within (0, max]
DEPOSITS_MIN_TERM_MONTHS=1
DEPOSITS_MAX_TERM_MONTHS=60
DEPOSITS_EARLY_CLOSE_RATE=0.01     # interest is recalculated at this rate on early closing
DEPOSITS_CONSUMER_GROUP=elbank-deposits
DEPOSITS_ACCRUAL_BATCH_SIZE=100

# ---------- Statements ----------
STATEMENTS_DIR=uploads/statements # docker-compose overrides with /app/uploads/statements
STATEMENTS_JOB_TTL_SECONDS=86400
STATEMENTS_MAX_PERIOD_DAYS=366
STATEMENTS_CONSUMER_GROUP=elbank-statements

# ---------- Operation history export ----------
EXPORTS_DIR=uploads/exports       # docker-compose overrides with /app/uploads/exports
EXPORTS_JOB_TTL_SECONDS=86400
EXPORTS_MAX_PERIOD_DAYS=366
EXPORTS_PDF_MAX_ROWS=5000         # larger periods must be exported as CSV
EXPORTS_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf  # any TTF with Cyrillic
EXPORTS_CONSUMER_GROUP=elbank-exports

# ---------- Analytics ----------
ANALYTICS_CACHE_TTL_SECONDS=300   # Redis analytics:{user_id}, dropped on operation.completed
ANALYTICS_MAX_PERIOD_DAYS=366

# ---------- Budgets ----------
BUDGETS_WARN_PERCENT=80           # notification.send "warn" from here, "danger" at 100 %
BUDGETS_MAX_PER_USER=50
BUDGETS_CONSUMER_GROUP=elbank-operations  # operations worker (operation.completed)

# ---------- Support ----------
SUPPORT_UPLOADS_DIR=uploads/support      # ticket attachments; docker-compose: /app/uploads/support
SUPPORT_MAX_ATTACHMENTS=5                # per ticket (JPEG, PNG, PDF)
SUPPORT_MAX_ATTACHMENT_BYTES=5242880
SUPPORT_FAQ_CACHE_TTL_SECONDS=600        # Redis faq:articles
SUPPORT_WS_QUEUE_SIZE=100                # events buffered per WebSocket, then it is closed (1013)

# ---------- Notifications (worker: notification.send -> sms/email/push gateways) ----------
NOTIFICATIONS_TIMEOUT_SECONDS=3.0
NOTIFICATIONS_RETRIES=3                  # extra attempts on 5xx / timeout / connection error, never on 4xx
NOTIFICATIONS_CONSUMER_GROUP=elbank-notifications

# ---------- Transfers ----------
TRANSFERS_FEE_PERCENT=0.5
TRANSFERS_FEE_MIN=10.00
TRANSFERS_FEE_MAX=5000.00
TRANSFERS_CANCEL_WINDOW_SECONDS=60   # pending transfer can be cancelled, then it is completed
TRANSFERS_LOCK_TTL_SECONDS=30        # Redis op_lock:{user_id}:{idempotency_key}
TRANSFERS_LOCK_WAIT_SECONDS=5        # parallel request with the same key waits, then 409
TRANSFERS_CONVERSION_FEE_PERCENT=1
TRANSFERS_EXTERNAL_TIMEOUT_FAIL_AFTER_SECONDS=5   # unconfirmed (timed out) external transfer fails after
TRANSFERS_EXTERNAL_STALE_AFTER_SECONDS=120        # external transfer stuck in processing fails after
TRANSFERS_FINALIZER_INTERVAL_SECONDS=5
TRANSFERS_FINALIZER_BATCH_SIZE=100

# ---------- Health checks ----------
READINESS_TIMEOUT_SECONDS=2.0

# ---------- docker-compose only ----------
ELK_VERSION=8.17.4
# Host port for the Redis container; keep in sync with REDIS_URL.
REDIS_HOST_PORT=6379
# Host ports for containers (APP_PORT and POSTGRES_PORT above are reused as host ports).
KAFKA_HOST_PORT=29092
KAFKA_UI_HOST_PORT=8080
WIREMOCK_HOST_PORT=8081
