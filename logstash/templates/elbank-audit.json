{
  "index_patterns": ["elbank-audit-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp":     { "type": "date" },
        "timestamp":      { "type": "date" },
        "action":         { "type": "keyword" },
        "actor_id":       { "type": "keyword" },
        "user_id":        { "type": "keyword" },
        "entity":         { "type": "keyword" },
        "entity_id":      { "type": "keyword" },
        "details":        { "type": "flattened" },
        "correlation_id": { "type": "keyword" },
        "service":        { "type": "keyword" },
        "env":            { "type": "keyword" },
        "level":          { "type": "keyword" },
        "logger":         { "type": "keyword" },
        "log_type":       { "type": "keyword" },
        "message":        { "type": "text" }
      }
    }
  }
}
